---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" description="We couldn't find that page.">
  <section class="container-site pt-20 md:pt-28 pb-20 min-h-[50vh] flex items-center">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">404</p>
      <h1 class="font-serif text-[clamp(2rem,4.5vw,3.25rem)] leading-[1.1] tracking-[-0.02em]">
        We couldn&rsquo;t find that page.
      </h1>
      <p class="prose-body mt-6">
        <a href="/" class="text-terracotta hover:text-ember underline underline-offset-4 decoration-terracotta/30">Back to the home page</a>.
      </p>
    </div>
  </section>
</Layout>
