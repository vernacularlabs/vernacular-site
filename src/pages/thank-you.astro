---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thank you" description="Thanks for reaching out. We'll be in touch soon.">
  <section class="container-site pt-20 md:pt-28 pb-20 min-h-[50vh] flex items-center">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Thanks for reaching out</p>
      <h1 class="font-serif text-[clamp(2rem,4.5vw,3.25rem)] leading-[1.1] tracking-[-0.02em]">
        We&rsquo;ll get back to you <em>shortly</em>.
      </h1>
      <p class="prose-body mt-6">
        Your message is on its way to the team. In the meantime, feel free to
        <a href="/products" class="text-terracotta hover:text-ember underline underline-offset-4 decoration-terracotta/30">read about how our process works</a>
        or <a href="/" class="text-terracotta hover:text-ember underline underline-offset-4 decoration-terracotta/30">return to the home page</a>.
      </p>
    </div>
  </section>
</Layout>
