                                  ---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Text Opt-In" description="Sign up to receive text messages from Vernacular Labs about our surveys and research.">
  <section class="container-site pt-14 md:pt-20 pb-16">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-5">
        <p class="eyebrow mb-4">Stay in the loop</p>
        <h1 class="font-serif text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.05] tracking-[-0.02em]">
          Join our surveys.
        </h1>
        <p class="prose-body mt-6">
          Sign up to participate in Vernacular Labs voice surveys and receive
          occasional text updates about our research. Your number will never
          be shared or sold.
        </p>
        <p class="prose-body mt-4 text-ash text-[15px]">
          You can also opt in at 
          <a href="https://subscribeme.org/VernacularLabs" target="_blank" rel="noopener noreferrer"
             class="text-terracotta hover:text-ember underline underline-offset-4 decoration-terracotta/30"
          >subscribeme.org/VernacularLabs</a>.
        </p>
      </div>
      <div class="md:col-span-7">
        <form name="sms-optin" method="POST" action="/thank-you" data-netlify="true"
              netlify-honeypot="bot-field"
              class="space-y-5 p-8 md:p-10 rounded-2xl bg-paper border border-fog/40">
          <input type="hidden" name="form-name" value="sms-optin" />
          <p class="hidden"><label>Don’t fill this out: <input name="bot-field" /></label></p>
          <div>
            <label for="name" class="block text-[14px] font-medium text-coal mb-2">Your name</label>
            <input id="name" name="name" type="text" required class="form-input" placeholder="Jane Doe" />
          </div>
          <div>
            <label for="phone" class="block text-[14px] font-medium text-coal mb-2">
              Phone number <span class="text-ash font-normal">(optional)</span>
            </label>
            <input id="phone" name="phone" type="tel" class="form-input" placeholder="(555) 000-0000" />
          </div>
          <div class="flex items-start gap-3 pt-1">
            <input id="consent" name="consent" type="checkbox" required
                   class="mt-1 h-4 w-4 rounded border-fog/60 text-terracotta focus:ring-terracotta shrink-0" />
            <label for="consent" class="text-[14px] leading-[1.6] text-coal">
              I agree to receive recurring automated text messages from Vernacular Labs.
              Msg frequency varies. Reply STOP to cancel, HELP for help.
              Msg &amp; data rates may apply. You can view our 
              <a href="https://subscribeme.org/terms.php?code=VernacularLabs" target="_blank" rel="noopener noreferrer"
                 class="text-terracotta hover:text-ember underline underline-offset-4 decoration-terracotta/30"
              >Terms &amp; Conditions</a>
               and 
              <a href="https://subscribeme.org/privacy.php?code=VernacularLabs" target="_blank" rel="noopener noreferrer"
                 class="text-terracotta hover:text-ember underline underline-offset-4 decoration-terracotta/30"
              >Privacy Policy</a>.
            </label>
          </div>
          <div class="pt-2">
            <button type="submit" class="btn-primary w-full md:w-auto">Sign me up</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>
