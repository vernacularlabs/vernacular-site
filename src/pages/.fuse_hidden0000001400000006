---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact" description="We're running pilot projects with mission-aligned partners ahead of a broader launch. Get in touch.">

  <section class="container-site pt-14 md:pt-20 pb-10">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-5">
        <p class="eyebrow mb-4">Contact</p>
        <h1 class="font-serif text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.05] tracking-[-0.02em]">
          Let&rsquo;s talk.
        </h1>
        <p class="prose-body mt-6">
          We&rsquo;re running pilot projects with mission-aligned partners ahead of a broader launch.
          If you&rsquo;re working on 2026 or 2028 and want to understand your electorate differently,
          we want to hear from you.
        </p>
        <p class="prose-body mt-4 text-ash">
          Prefer email? Write to us at
          <a href="mailto:info@vernacularlabs.ai" class="text-terracotta hover:text-ember underline underline-offset-4 decoration-terracotta/30">info@vernacularlabs.ai</a>.
        </p>
      </div>

      <div class="md:col-span-7">
        <form
          name="contact"
          method="POST"
          action="/thank-you"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-5 p-8 md:p-10 rounded-2xl bg-paper border border-fog/40"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Don&rsquo;t fill this out: <input name="bot-field" /></label>
          </p>

          <div>
            <label for="name" class="block text-[14px] font-medium text-coal mb-2">Your name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="form-input"
              placeholder="Jane Doe"
            />
          </div>

          <div>
            <label for="email" class="block text-[14px] font-medium text-coal mb-2">Your email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="form-input"
              placeholder="you@example.org"
            />
          </div>

          <div>
            <label for="organization" class="block text-[14px] font-medium text-coal mb-2">Organization <span class="text-ash font-normal">(optional)</span></label>
            <input
              id="organization"
              name="organization"
              type="text"
              class="form-input"
              placeholder="Campaign, committee, nonprofit, etc."
            />
          </div>

          <div>
            <label for="message" class="block text-[14px] font-medium text-coal mb-2">How can we help?</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="form-input resize-y"
              placeholder="Tell us a bit about what you're working on."
            ></textarea>
          </div>

          <div class="pt-2">
            <button type="submit" class="btn-primary w-full md:w-auto">Send message</button>
          </div>
        </form>
      </div>
    </div>
  </section>

</Layout>
